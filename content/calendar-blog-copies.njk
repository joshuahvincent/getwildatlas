---
# Blog copies of conservation-calendar pages. One page per calendar entry in
# collections.calendarBlogDue (approved + date reached), at /blog/<slug>/.
# Canonical points at the calendar page, which is the primary copy.
pagination:
  data: collections.calendarBlogDue
  size: 1
  alias: entry
  addAllPagesToCollections: true
permalink: "/blog/{{ entry.page.fileSlug }}/"
layout: layouts/animal-day.njk
tags: [blogCopy]
---
{% renderFile entry.inputPath %}
