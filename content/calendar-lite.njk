---
# Lite calendar pages: one per entry in _data/liteDays.js (animal is in a
# Wild Atlas pack, no full article yet). Content comes from the app.
pagination:
  data: liteDays
  size: 1
  alias: lite
  addAllPagesToCollections: true
permalink: "/calendar/{{ lite.slug }}/"
layout: layouts/animal-day.njk
tags: [calendarLite]
backLink: { url: "/calendar/", label: "Conservation calendar" }
---
{%- set a = lite.animal -%}{%- set t = a.text -%}
{% if a.images.cover %}{% figure a.images.cover, "A " + a.name + " in the wild" %}{% endif %}

{{ t["summary.young"] }}

{% for f in (t["fun_facts.young"] or []) | batch(4) | first %}
{{ f }}
{% endfor %}

{% if a.images.scale %}{% figure a.images.scale, "Illustration comparing the size of a " + a.name + " with a five-year-old child" %}{% endif %}

{% if t["size_comparison.young"] %}{{ t["size_comparison.young"] }}{% endif %} {% if t["weight_comparison.young"] %}{{ t["weight_comparison.young"] }}{% endif %}

{% if a.images.baby %}{% figure a.images.baby, "A baby " + a.name %}{% endif %}

{% if t["map_narration"] %}{{ t["map_narration"] }}{% endif %}
