---
layout: layouts/blog-base.njk
title: Blog
permalink: /blog/
excerpt: "Notes from the Wild Atlas founder and team — on building an animal app for kids, conservation, and what we've learned along the way."
eleventyExcludeFromCollections: true
---
<section class="blog-index">
  <header>
    <h1>The Wild Atlas Blog</h1>
    <p style="color: var(--muted); font-size: 1.1rem;">
      Notes from the founder and team — on building, conservation, and what we've learned along the way.
    </p>
  </header>

  {% if collections.posts.length == 0 %}
    <p><em>No posts yet — coming soon.</em></p>
  {% else %}
    <ul class="blog-list" style="list-style: none; padding: 0; margin: 2rem 0;">
      {% for post in collections.posts %}
        <li class="blog-list-item" style="padding: 1.5rem 0; border-bottom: 1px solid var(--rule);">
          <a href="{{ post.url }}" style="display: flex; gap: 1.25rem; align-items: flex-start; text-decoration: none; color: inherit;">
            {% if post.data.coverImage %}
              <img src="{{ post.data.coverImage }}" alt="" style="width: 120px; height: 80px; object-fit: cover; border-radius: 6px; flex-shrink: 0; margin: 0;">
            {% endif %}
            <div>
              <h2 style="margin: 0 0 0.25rem; color: var(--accent);">{{ post.data.title }}</h2>
              <p class="blog-list-meta" style="color: var(--muted); margin: 0 0 0.4rem; font-size: 0.9rem;">
                <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
                {% if post.data.author %} · {{ post.data.author }}{% endif %}
              </p>
              {% if post.data.excerpt %}
                <p style="margin: 0; font-size: 0.95rem;">{{ post.data.excerpt }}</p>
              {% endif %}
            </div>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <hr style="border: none; border-top: 1.5px solid rgba(93, 64, 55, 0.08); margin: var(--space-2xl) 0 0;">

  <section class="email-signup" aria-labelledby="es-blogindex-heading">
    <div class="email-signup-inner">
      <p class="email-signup-eyebrow">For parents &amp; guardians</p>
      <h2 id="es-blogindex-heading" class="email-signup-heading">The app is for the kids. This part is for you.</h2>
      <p class="email-signup-sub">New packs, app features, and an occasional note. Sent a few times a year &mdash; no more.</p>
      <p class="email-signup-incentive">🎁 Subscribe and the <strong>Farm Friends</strong> pack ($3.99) is <strong>free</strong> &mdash; yours to keep even if you unsubscribe.</p>
      <form class="email-signup-form" action="/api/subscribe" method="POST" novalidate>
        <input type="hidden" name="source" value="blog-footer">
        <div class="email-signup-row">
          <label class="sr-only" for="es-blogindex-email">Email address</label>
          <input id="es-blogindex-email" class="email-signup-input" type="email" name="email" required autocomplete="email" placeholder="your@email.com">
          <button class="email-signup-btn" type="submit">Subscribe</button>
        </div>
        <label class="email-signup-consent">
          <input type="checkbox" name="consent" required>
          <span>I agree to receive occasional emails from Wild Atlas about new packs, app updates, and parent notes.</span>
        </label>
        <p class="email-signup-fine">We email occasionally &mdash; easy to unsubscribe anytime. We use <a href="https://www.beehiiv.com" target="_blank" rel="noopener">beehiiv</a> to send these emails. See our <a href="/privacy">Privacy Policy</a>.</p>
        <p class="email-signup-msg" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>
  <script src="/js/email-signup.js" defer></script>
</section>
