<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }} — Wild Atlas</title>
  <meta name="description" content="{{ excerpt or 'The Wild Atlas blog — notes from the founder and team.' }}">
  <meta name="robots" content="{% if noindex %}noindex, nofollow{% else %}index, follow{% endif %}">
  <link rel="canonical" href="https://wildatlasapp.com{{ page.url }}">

  <meta name="theme-color" content="#FFF5E1">

  <meta property="og:type" content="article">
  <meta property="og:url" content="https://wildatlasapp.com{{ page.url }}">
  <meta property="og:title" content="{{ title }} — Wild Atlas">
  <meta property="og:description" content="{{ excerpt or 'The Wild Atlas blog.' }}">
  <meta property="og:image" content="https://wildatlasapp.com/assets/og-image.png">
  <meta property="og:site_name" content="Wild Atlas">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} — Wild Atlas">
  <meta name="twitter:description" content="{{ excerpt or 'The Wild Atlas blog.' }}">
  <meta name="twitter:image" content="https://wildatlasapp.com/assets/og-image.png">

  <link rel="icon" type="image/png" href="/assets/app-icon.png">
  <link rel="apple-touch-icon" href="/assets/app-icon.png">

  <link rel="preload" href="/fonts/Fredoka-VariableFont_wdth,wght.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="preload" href="/fonts/Nunito-Regular.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    :root {
      --bg: #FFF5E1;
      --ink: #2A2118;
      --muted: #6B5E4F;
      --accent: #C25A2C;
      --rule: #E9DCC2;
      --max: 720px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Nunito", system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 18px;
      line-height: 1.6;
    }
    .page-shell {
      max-width: var(--max);
      margin: 0 auto;
      background: var(--bg);
      min-height: 100vh;
      padding-top: 72px;
    }
    main { padding: 2rem 1.5rem 3rem; }
    .blog-footer {
      border-top: 1px solid var(--rule);
      color: var(--muted);
      font-size: 0.9rem;
      text-align: center;
      padding: 1.25rem 1.5rem;
    }
    /* Blog content typography */
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    p { margin: 0 0 1.25rem; }
    h1, h2, h3 {
      font-family: "Fredoka", system-ui, sans-serif;
      font-weight: 700;
      line-height: 1.25;
      color: var(--ink);
    }
    h1 { font-size: 2rem; margin: 0 0 0.5rem; }
    h2 { font-size: 1.5rem; margin: 2rem 0 0.5rem; }
    h3 { font-size: 1.15rem; margin: 1.5rem 0 0.5rem; }
    blockquote {
      border-left: 3px solid var(--accent);
      margin: 1.5rem 0;
      padding: 0.25rem 1rem;
      color: var(--muted);
      font-style: italic;
    }
    hr { border: 0; border-top: 1px solid var(--rule); margin: 2rem 0; }
    img { max-width: 100%; height: auto; border-radius: 8px; }
    .blog-post-label {
      display: inline-block;
      font-family: "Fredoka", system-ui, sans-serif;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--accent);
      background: rgba(194, 90, 44, 0.1);
      border-radius: 4px;
      padding: 0.2rem 0.6rem;
      margin: 0.5rem 0 0.75rem;
    }
    ul, ol { padding-left: 1.5rem; }
    li { margin-bottom: 0.4rem; }
    figure { margin: 2rem 0; }
    figure img { width: 100%; height: auto; border-radius: 8px; display: block; }
    figcaption {
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--muted);
      font-style: italic;
      text-align: center;
    }
  </style>
</head>
<body class="blog-body">

  <nav class="navbar" id="navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <img src="/assets/mascot-logo.png" alt="Wild Atlas" class="nav-icon">
        <span class="nav-title">Wild Atlas</span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="/#features">Features</a></li>
        <li><a href="/#parents">For Parents</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/press">Press</a></li>
        <li><a href="https://apps.apple.com/us/app/wild-atlas/id6761081031" class="nav-cta">Download Free</a></li>
      </ul>
    </div>
  </nav>

  <div class="page-shell">
    <main>
      {{ content | safe }}
    </main>

    <footer class="blog-footer">
      <p>&copy; 2026 Wild Atlas. All rights reserved.</p>
    </footer>
  </div>

  <script>
    (function () {
      var navbar = document.getElementById('navbar');
      window.addEventListener('scroll', function () {
        if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 10);
      });
      var toggle = document.getElementById('navToggle');
      var links = document.getElementById('navLinks');
      if (toggle && links) {
        toggle.addEventListener('click', function () {
          toggle.classList.toggle('active');
          links.classList.toggle('open');
        });
        links.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            toggle.classList.remove('active');
            links.classList.remove('open');
          });
        });
      }
    })();
  </script>

</body>
</html>
