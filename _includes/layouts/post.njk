---
layout: layouts/blog-base.njk
---
<style>
  /* The site stylesheet turns list bullets off globally (ul { list-style: none }).
     Put them back for plain lists in post and calendar bodies; classed lists (legends, cards) keep their own styling. */
  :where(.blog-post-body) ul:not([class]) { list-style: disc; padding-left: 1.4rem; }
  :where(.blog-post-body) ol:not([class]) { list-style: decimal; padding-left: 1.4rem; }
  :where(.blog-post-body) li::marker { color: #5D4037; }
</style>
<article class="blog-post">
  <header class="blog-post-header">
    <p class="blog-post-meta">
      <a href="{{ backLink.url if backLink else '/blog/' }}">← {{ backLink.label if backLink else 'All posts' }}</a>
    </p>
    {#- Calendar pages show the next real date ("Friday, May 21"), rebuilt daily so it rolls over each year; never a year. -#}
    {%- set isCalendarPage = page.url and page.url.startsWith("/calendar/") %}
    {%- if isCalendarPage %}
    {%- set dd = page.date | perennialDate(page.fileSlug, appId) %}
    <p class="day-date" style="display: inline-block; margin: 0.6rem 0 0; padding: 0.3rem 0.95rem; font-family: 'Fredoka', sans-serif; font-weight: 600; font-size: clamp(1.35rem, 3.6vw, 1.7rem); line-height: 1.2; color: #5D4037; background: #FFF4CC; border: 2px solid #5D4037; border-radius: 999px;">{% if dd.isToday %}Today! · {% endif %}{{ dd.date }}</p>
    {%- if dd.note %}<p class="day-date-note" style="margin: 0.3rem 0 0; font-weight: 700; font-size: 0.92rem; color: rgba(93, 64, 55, 0.8);">{{ dd.note }}</p>{% endif %}
    {%- endif %}
    <h1>{{ title }}</h1>
    <p class="blog-post-byline" style="color: var(--muted); margin-top: 0.25rem;">
      {% if not hideDate and not isCalendarPage %}<time datetime="{{ (postDate or page.date) | isoDate }}">{{ (postDate or page.date) | readableDate }}</time> · {% endif %}{{ author }}
      {% if content %} · {{ content | readingTime }}{% endif %}
    </p>
  </header>

  <div class="blog-post-body">
    {{ content | safe }}
  </div>

  <hr>

  <section class="email-signup" aria-labelledby="es-blog-heading">
    <div class="email-signup-inner">
      <p class="email-signup-eyebrow">For parents &amp; guardians</p>
      <h2 id="es-blog-heading" class="email-signup-heading">The app is for the kids. This part is for you.</h2>
      <p class="email-signup-sub">New packs, app features, and an occasional note. Sent a few times a year &mdash; no more.</p>
      <p class="email-signup-incentive"><img class="incentive-icon" src="/assets/newsletter-gift.png" alt="">Subscribe and the <strong>Farm Friends</strong> pack ($3.99) is <strong>free</strong> &mdash; yours to keep even if you unsubscribe.</p>
      <form class="email-signup-form" action="/api/subscribe" method="POST" novalidate>
        <input type="hidden" name="source" value="blog-footer">
        <div class="email-signup-row">
          <label class="sr-only" for="es-blog-email">Email address</label>
          <input id="es-blog-email" class="email-signup-input" type="email" name="email" required autocomplete="email" placeholder="your@email.com">
          <button class="email-signup-btn" type="submit">Subscribe</button>
        </div>
        <label class="email-signup-consent">
          <input type="checkbox" name="consent" required>
          <span>I agree to receive occasional emails from Wild Atlas about new packs, app updates, and parent notes.</span>
        </label>
        <p class="email-signup-fine">We email occasionally &mdash; easy to unsubscribe anytime. We use <a href="https://www.beehiiv.com" target="_blank" rel="noopener">beehiiv</a> to send these emails. See our <a href="/privacy">Privacy Policy</a>.</p>
        <p class="email-signup-msg" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>
  <script src="/js/email-signup.js?v=2" defer></script>
</article>
