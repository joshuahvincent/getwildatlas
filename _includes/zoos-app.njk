<link rel="stylesheet" href="/js/vendor/maplibre/maplibre-gl.css">
<link rel="stylesheet" href="/css/zoos.css?v=30">

<div class="zf" id="zf" data-animal="{{ a.id if a else '' }}">
  <h1 class="zf-title">Find a place to see real animals</h1>

  <div class="zf-controls" id="zf-controls">
    <div class="zf-summary" id="zf-summary" hidden>
      <button type="button" class="zf-sumbtn" id="zf-edit" aria-expanded="false" aria-controls="zf-panel"><span class="zf-sum-text" id="zf-sum-text"></span><span class="zf-sumedit">Change</span></button>
    </div>
    <div class="zf-panel" id="zf-panel">
      <div class="zf-bar" role="search">
        <div class="zf-field zf-animalfield">
          <label for="zf-animal" class="sr-only">Animal or place</label>
          <input type="text" id="zf-animal" class="zf-input" role="combobox" aria-expanded="false" aria-controls="zf-animal-list" aria-autocomplete="list" placeholder="Search an animal or a place (lion, T. rex, Point Defiance…)" autocomplete="off" autocapitalize="off" spellcheck="false">
          <button type="button" class="zf-clear" id="zf-animal-clear" aria-label="Clear animal" hidden>×</button>
          <ul id="zf-animal-list" class="zf-suggest" role="listbox" aria-label="Animals and places" hidden></ul>
        </div>
        <div class="zf-field zf-locfield">
          <label for="zf-q" class="sr-only">City or postcode</label>
          <input type="text" id="zf-q" class="zf-input" role="combobox" aria-expanded="false" aria-controls="zf-suggest" aria-autocomplete="list" placeholder="City or postcode" autocomplete="off" autocapitalize="off" spellcheck="false">
          <ul id="zf-suggest" class="zf-suggest" role="listbox" aria-label="Places" hidden></ul>
        </div>
        <button type="button" class="zf-btn zf-locate" id="zf-locate"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/></svg><span class="zf-locate-text">Use my location</span></button>
      </div>
      <div class="zf-metaline">
        <button type="button" class="zf-advbtn" id="zf-adv-sum" aria-expanded="false" aria-controls="zf-advbody">More filters</button>
        <p class="zf-notice" id="zf-notice"><span class="zf-notice-i" aria-hidden="true">i</span>Animals move around, so check with the place before you visit.</p>
        <span class="zf-forgetwrap" id="zf-forgetwrap" hidden><button type="button" class="zf-linkbtn" id="zf-forget">Forget my location</button></span>
      </div>
      <div class="zf-advbody" id="zf-advbody" hidden>
        <fieldset class="zf-dist zf-types" id="zf-dist"><legend>How far</legend><div class="zf-chips" id="zf-chips"></div></fieldset>
        <fieldset class="zf-types" id="zf-types"><legend>Type of place</legend><div class="zf-chips zf-typechips" id="zf-typechips"></div></fieldset>
      </div>
    </div>
  </div>

  <p class="zf-quick" id="zf-quick" hidden></p>
  <p class="zf-status" id="zf-status" role="status" aria-live="polite"></p>

  <div class="zf-tabs" id="zf-tabs" role="group" aria-label="View">
    <button type="button" id="zf-tab-list" aria-pressed="true">List</button>
    <button type="button" id="zf-tab-map" aria-pressed="false">Map</button>
  </div>

  <div class="zf-main" id="zf-main" data-size="large">
    <div class="zf-listpane" id="zf-listpane">
      <div id="zf-results">
        {%- if a %}
        <section class="zf-sec" id="zf-seo-list">
          <h2>Where to see {{ a.article }} {{ a.name }}</h2>
          <p>{{ a.summary }}</p>
          <ul class="zf-seo-places">
            {%- for p in a.top %}
            <li><strong>{{ p.n }}</strong>, {{ p.where }}</li>
            {%- endfor %}
          </ul>
          {%- if a.wild.length %}
          <h3>See it in the wild</h3>
          <p>Wild {{ a.name }} are recorded in national parks and reserves such as {{ a.wild | join(', ') }}{% if a.wildTotal > a.wild.length %}, and {{ a.wildTotal - a.wild.length }} more{% endif %}. Wildlife is never guaranteed.</p>
          {%- endif %}
          <p>Turn on JavaScript to see all {{ a.total }} places on a map, sorted by distance from you.</p>
        </section>
        {%- endif %}
      </div>
    </div>
    <div class="zf-mappane" id="zf-mappane">
      <div class="zf-maptools"><button type="button" class="zf-sizebtn" id="zf-size" aria-pressed="true">Smaller map</button></div>
      <div class="zf-map" id="zf-map" role="region" aria-label="Map of the places in the list. The list has the same places."></div>
      <ul class="zf-legend" id="zf-legend"></ul>
      <p class="zf-notice zf-notice-map"><span class="zf-notice-i" aria-hidden="true">i</span>Animals move around, so check with the place before you visit.</p>
      <div class="zf-missing"><button type="button" class="zf-btn zf-btn-add" id="zf-suggest-open">Can't find your place here? Add it</button></div>
    </div>
  </div>

  {%- if a and a.related.length %}
  <nav class="zf-seo" aria-label="Related animals">
    <h2>More animals to find</h2>
    <ul class="zf-seo-links">{% for r in a.related %}<li><a href="/zoos/{{ r.slug }}/">{{ r.name }}</a></li>{% endfor %}</ul>
    <p><a href="/zoos/">Browse all animals</a></p>
  </nav>
  {%- endif %}

  <footer class="zf-foot">
    <p>A badge (AZA, CAZA, EAZA, BIAZA, ZAA) means the place is a member of that zoo association. Places without a badge may be accredited by another body or not at all, so please check them yourself. Museums are public natural-history museums. Farms and petting zoos come from OpenStreetMap and are not accredited. Places are independent of Wild Atlas, and listing a place does not mean it works with us.</p>
    <p class="zf-credits">Map outlines: Natural Earth (public domain). Street map (shown when you zoom in to a city): <a href="https://openfreemap.org" rel="noopener">OpenFreeMap</a>, © <a href="https://openmaptiles.org" rel="noopener">OpenMapTiles</a>, data © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap contributors</a>. City and postcode locations: <a href="https://www.geonames.org" rel="noopener">GeoNames</a> (CC BY 4.0). Place photos: Wikimedia Commons, credited on each card.</p>
    <p><a class="zf-app" href="https://apps.apple.com/us/app/wild-atlas/id6761081031?ct=find_a_zoo&amp;utm_source=website&amp;utm_medium=owned&amp;utm_campaign=find_a_zoo">Meet the animals in Wild Atlas first →</a></p>
  </footer>
</div>

<dialog id="zf-suggest-dialog" class="zf-dialog zf-suggest-dlg" aria-labelledby="zf-suggest-h">
  <form id="zf-suggest-form" novalidate>
    <h2 id="zf-suggest-h">Add your place</h2>
    <p class="zf-dialog-note">Tell us about a zoo, aquarium, museum, farm or park that is missing. We check each one before it goes on the map.</p>
    <label class="zf-fl">Name of the place<input name="establishment" required maxlength="160" autocomplete="organization"></label>
    <label class="zf-fl">Animal(s) you can see there<input name="animal" id="zf-suggest-animal" maxlength="160" placeholder="For example: lion, giraffe"></label>
    <label class="zf-fl">Address<input name="address" required maxlength="300" autocomplete="street-address" placeholder="Street, city, country"></label>
    <label class="zf-fl">Website link<input name="website" type="url" inputmode="url" maxlength="300" placeholder="https://" autocomplete="url"></label>
    <label class="zf-fl">Contact email<input name="email" type="email" required maxlength="160" autocomplete="email"></label>
    <label class="zf-hp" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off"></label>
    <p class="zf-dialog-note">We only use your email to ask about the place. We do not add it to any list.</p>
    <p class="zf-suggest-msg" id="zf-suggest-msg" role="status" aria-live="polite"></p>
    <div class="zf-dialog-actions">
      <button type="submit" class="zf-btn" id="zf-suggest-send">Send</button>
      <button type="button" class="zf-btn zf-btn-quiet" id="zf-suggest-close">Close</button>
    </div>
  </form>
</dialog>
<dialog id="zf-geo" class="zf-dialog" aria-labelledby="zf-geo-h">
  <form method="dialog">
    <h2 id="zf-geo-h">Share your location?</h2>
    <p>We use it only to sort places by how close they are to you. It stays in your browser and we never send it anywhere. We remember it on this device so you do not have to enter it again, and you can clear it any time.</p>
    <p class="zf-dialog-note">Your browser will ask you to confirm next. Prefer not to? Type a city or postcode instead.</p>
    <div class="zf-dialog-actions">
      <button class="zf-btn" value="share" autofocus>Share my location</button>
      <button class="zf-btn zf-btn-quiet" value="cancel">Not now</button>
    </div>
  </form>
</dialog>

<script type="module" src="/js/zoos.js?v=58"></script>
<noscript><p>This page needs JavaScript to find places near you. The list above shows some places to start with, and you can browse the <a href="/blog/">Wild Atlas blog</a> in the meantime.</p></noscript>
